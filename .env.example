# Copy this file to .env and fill in your values. Never commit .env.

# Your OpenRouter key (create a NEW one - the old key in your notebook is exposed)
OPENROUTER_API_KEY=paste-your-new-key-here

# Postgres connection string. Any Postgres works (Neon, Supabase, Railway, local).
# If you use Vercel's own Postgres storage integration, it injects POSTGRES_URL
# automatically and you can leave this blank on Vercel - but you still need it
# here for local development.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: the model new chats start with. Copy an exact ID from
# https://openrouter.ai/models  (format: provider/model-name)
# Leave blank to pick from the dropdown in the app instead.
DEFAULT_MODEL=

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# How many recent messages are sent to the model with each request
MAX_HISTORY_MESSAGES=20
